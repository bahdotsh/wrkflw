FROM ubuntu:latest
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl bash git ca-certificates gnupg build-essential less sudo jq unzip zip wget xz-utils zstd file openssh-client rsync git-lfs python3 python3-pip python3-venv python-is-python3 libncurses6 libssl-dev pkg-config && \
    (other="$(getent passwd 1001 | cut -d: -f1)"; [ -z "$other" ] || [ "$other" = runner ] || userdel -r "$other" 2>/dev/null || true) && (getent group runner >/dev/null || groupadd --non-unique --gid 1001 runner) && (id -u runner >/dev/null 2>&1 || useradd --no-log-init --create-home --home-dir /home/runner --uid 1001 --gid runner --shell /bin/bash runner) && echo 'runner ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/runner && chmod 0440 /etc/sudoers.d/runner && mkdir -p /home/runner/.cargo /home/runner/.cache /home/runner/.config /home/runner/.local/bin /home/runner/.npm /home/runner/go/pkg /opt/hostedtoolcache && chown -R runner:runner /home/runner /opt/hostedtoolcache && for dir in /opt /usr/local/bin /usr/local/lib /usr/local/share /usr/local/include; do [ ! -d "$dir" ] || chown runner:runner "$dir"; done && \
    (command -v node >/dev/null 2>&1 || (dir=$(mktemp -d) && (cd "$dir" && arch=$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/') && curl -fsSLO https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt && file=$(grep -o "node-v[0-9.]*-linux-$arch\.tar\.gz" SHASUMS256.txt | head -n 1) && test -n "$file" && curl -fsSLO https://nodejs.org/dist/latest-v22.x/$file && grep " $file\$" SHASUMS256.txt > node.sum && sha256sum -c node.sum >/dev/null && mkdir node && tar -xzf "$file" -C node --strip-components=1 --no-same-owner --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' && cp -a node/. /usr/local/); status=$?; [ -z "$dir" ] || rm -rf "$dir"; exit $status) || (curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/node-setup.sh && bash /tmp/node-setup.sh && rm -f /tmp/node-setup.sh && apt-get install -y nodejs && node --version)) && \
    (prefix="$(npm prefix -g 2>/dev/null)"; if [ "$prefix" = /usr/local ]; then chown -hR runner:runner /usr/local/lib/node_modules /usr/local/bin /usr/local/include /usr/local/share 2>/dev/null || true; else npm config --global set prefix /usr/local; fi) && \
    rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/local/bin:/usr/bin:$PATH
RUN command -v gh >/dev/null 2>&1 || (mkdir -p -m 755 /etc/apt/keyrings && curl -fsSL --connect-timeout 10 --max-time 120 https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list && apt-get update -o Dir::Etc::sourcelist=sources.list.d/github-cli.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0 && apt-get install -y --no-install-recommends gh && rm -rf /var/lib/apt/lists/*)
